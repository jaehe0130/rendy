# 공용
DATABASE_URL=postgresql://rendy:rendy@localhost:5432/rendy
DATABASE_URL_UNPOOLED=postgresql://rendy:rendy@localhost:5432/rendy  # Neon이면 풀링 안 된 주소 (마이그레이션용)

# apps/api
API_PORT=4000
VISION_BASE_URL=http://localhost:8001
LLM_API_KEY=            # LLM 기능(상담·가이드 초안 등). 비우면 mock 응답
BLOB_READ_WRITE_TOKEN=  # Vercel Blob (사진은 브라우저가 직접 업로드, API 본문 4.5MB 제한)

# apps/web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_USE_MOCK=1  # 1이면 API 대신 mock 데이터

# ai/vision
VISION_MOCK=1           # 1이면 모델 없이 고정 응답
